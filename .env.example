# Copy this file to .env and fill it in. Never share .env; it holds your keys.

# From developers.facebook.com > your app > WhatsApp > API Setup
WA_TOKEN=paste-access-token-here
WA_PHONE_NUMBER_ID=paste-phone-number-id-here
# From App settings > Basic > App secret (lets the bot reject fake webhook calls)
WA_APP_SECRET=
# Any password you make up; type the same one into the Meta webhook settings
WA_VERIFY_TOKEN=choose-a-random-phrase

# Your own WhatsApp number(s), country code first, no + or spaces. Others are ignored.
ALLOWED_NUMBERS=919876543210

# Optional: AI extraction (much better titles and fields)
ANTHROPIC_API_KEY=

# Optional tuning
OUT_DIR=output
QUIET_SECONDS=30
VISION_IMAGES=0
