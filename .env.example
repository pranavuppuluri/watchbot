# Copy this file to .env and fill it in. Never share .env; it holds your keys.

# From developers.facebook.com > your app > WhatsApp > API Setup
WA_TOKEN=paste-access-token-here
WA_PHONE_NUMBER_ID=paste-phone-number-id-here
# From App settings > Basic > App secret (lets the bot reject fake webhook calls)
WA_APP_SECRET=
# Any password you make up; type the same one into the Meta webhook settings
WA_VERIFY_TOKEN=choose-a-random-phrase

# Your own WhatsApp number(s), country code first, no + or spaces. Others are ignored.
ALLOWED_NUMBERS=919876543210

# Optional: AI extraction (much better titles and fields)
ANTHROPIC_API_KEY=

# Optional tuning
OUT_DIR=output
QUIET_SECONDS=30
VISION_IMAGES=0

# ---- start-bot.bat / python -m watchbot run
# Where messages, photos, product folders and the catalog are saved
WATCHBOT_OUT=output
# Only save posts from these senders (WhatsApp names or numbers, comma separated); empty = anyone posting photos
WATCHBOT_SELLER=
# on = also run the website uploader
WATCHBOT_UPLOAD=off
# Where upload previews go: self = the linked number's own "Message yourself" chat, or a group name
WATCHBOT_APPROVAL=self

# ---- Website uploader (python -m watchbot upload, or WATCHBOT_UPLOAD=on)
# WordPress admin > Users > Profile > Application Passwords > add "watchbot", paste it here.
WC_URL=https://your-shop.example.com
WP_USER=
WP_APP_PASSWORD=
# Website price = dealer price + MARKUP_PERCENT% + MARKUP_FLAT, rounded up to PRICE_ROUND (0 = exact)
MARKUP_PERCENT=0
MARKUP_FLAT=0
PRICE_ROUND=0
# Photos: square, at most IMAGE_SIZE px. crop = centre square, pad = whole photo on IMAGE_BG
IMAGE_SIZE=1200
IMAGE_MODE=crop
IMAGE_BG=#ffffff
# Ask "still available?" about a watch on the site this many days with no re-post from the dealer (0 = never)
WATCHBOT_CHECK_DAYS=10
# Daily summary time (24h), or off
WATCHBOT_SUMMARY_AT=21:00
